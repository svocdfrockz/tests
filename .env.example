# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-01

# Optional: Fact-checking APIs
GOOGLE_FACT_CHECK_API_KEY=your-google-fact-check-api-key
SNOPES_API_KEY=your-snopes-api-key

# Monitoring and Logging
LOG_LEVEL=INFO
ENABLE_MONITORING=true
ALERT_WEBHOOK_URL=https://your-alert-webhook-url

# Domain-specific settings
MEDICAL_MODE=false
FINANCIAL_MODE=false
LEGAL_MODE=false

# Detection thresholds (0.0 to 1.0)
FACTUAL_CONFIDENCE_THRESHOLD=0.7
SOURCE_CONFIDENCE_THRESHOLD=0.8
CONTEXTUAL_RELEVANCE_THRESHOLD=0.3